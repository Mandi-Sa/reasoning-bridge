{
  "host": "0.0.0.0",
  "port": 8787,
  "upstreamBaseUrl": "http://127.0.0.1:8000",
  "upstreamApiKey": "replace-me",
  "upstreamPath": "/v1/chat/completions",
  "requestTimeoutMs": 600000,
  "cleanupIntervalMs": 300000,
  "logBody": false,
  "recentFallbackLimit": 32,
  "recentFallbackMinScore": 2,
